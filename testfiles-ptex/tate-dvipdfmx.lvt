% -*- mode: latex -*-
% vim: ft=tex
\documentclass{tarticle}
\input{regression-test}

\def\pgfsysdriver{pgfsys-dvipdfmx.def}
\usepackage{tikz}

\START

\catcode`\@=11
\showboxdepth=\maxdimen
\showboxbreadth=\maxdimen

\BEGINTEST{Driver supports the tate direction}
\ifdefined\pgfsys@ptex@tate@supported
  \TYPE{supported}
\else
  \TYPE{not supported}
\fi
\ENDTEST

\BEGINTEST{Picture and node in the tate direction}
\setbox0=\hbox{\tate\tikz{\draw (0,0) -- (1,0); \node[transform shape,rotate=90] {A};}}
\showbox0
\ENDTEST

\BEGINTEST{Picture in a yoko box inside the tate direction}
\setbox0=\hbox{\tate\hbox{\yoko\tikz{\draw (0,0) -- (1,0); \node {A};}}}
\showbox0
\ENDTEST

\BEGINTEST{Page positions are rotated in the tate direction}
\pgfsyspdfmark{pgfid@test}{65536}{131072}
\setbox0=\hbox{\tate\tikz{%
  \pgfsys@getposition{pgfid@test}\pgf@temp
  \pgf@process{\pgf@temp}%
  \TYPE{tate: (\the\pgf@x,\the\pgf@y)}%
  \pgf@process{\pgfpointanchor{current page}{north east}}%
  \pgf@xa=\pgf@x \pgf@ya=\pgf@y
  \pgf@process{\pgfpointanchor{current page}{south west}}%
  \advance\pgf@xa by-\pgf@x \advance\pgf@ya by-\pgf@y
  \TYPE{tate page: (\the\pgf@xa,\the\pgf@ya)}}}
\setbox0=\hbox{\yoko\tikz{%
  \pgfsys@getposition{pgfid@test}\pgf@temp
  \pgf@process{\pgf@temp}%
  \TYPE{yoko: (\the\pgf@x,\the\pgf@y)}}}
\setbox0=\hbox{\tate\tikz\node{\hbox{\yoko\tikz{%
  \pgf@process{\pgfpointanchor{current page}{north east}}%
  \pgf@xa=\pgf@x \pgf@ya=\pgf@y
  \pgf@process{\pgfpointanchor{current page}{south west}}%
  \advance\pgf@xa by-\pgf@x \advance\pgf@ya by-\pgf@y
  \TYPE{yoko in tate page: (\the\pgf@xa,\the\pgf@ya)}}}};}
\ENDTEST

\BEGINTEST{Material for the beginning of the page is always set yoko}
\setbox0=\hbox{\tate\tikz\shade[left color=red,right color=blue] (0,0) rectangle (1,1);}
\TYPE{\iftbox\pgfutil@abb tate\else\ifybox\pgfutil@abb yoko\else other\fi\fi}
\setbox0=\hbox{\yoko\tikz\shade[left color=red,right color=blue] (0,0) rectangle (1,1);}
\TYPE{\iftbox\pgfutil@abb tate\else\ifybox\pgfutil@abb yoko\else other\fi\fi}
\ENDTEST

\END
