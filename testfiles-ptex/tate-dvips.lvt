% -*- mode: latex -*-
% vim: ft=tex
\documentclass{tarticle}
\input{regression-test}

\def\pgfsysdriver{pgfsys-dvips.def}
\usepackage{tikz}

% Fix the page size, so that the size of the current page node does
% not depend on the default paper format.
\paperwidth=400pt
\paperheight=600pt

\START

\catcode`\@=11

\BEGINTEST{Driver supports the tate direction}
\ifdefined\pgfsys@ptex@tate@supported
  \TYPE{supported}
\else
  \TYPE{not supported}
\fi
\ENDTEST

\BEGINBOXTEST{Picture and node in the tate direction}
\tate\tikz{\draw (0,0) -- (1,0); \node[transform shape,rotate=90] {A};}
\ENDBOXTEST

\BEGINBOXTEST{Picture in a yoko box inside the tate direction}
\tate\hbox{\yoko\tikz{\draw (0,0) -- (1,0); \node {A};}}
\ENDBOXTEST

\BEGINTEST{Page positions are rotated in the tate direction}
\pgfsyspdfmark{pgfid@test}{65536}{131072}
\hbox{\tate\tikz{%
  \pgfsys@getposition{pgfid@test}\pgf@temp
  \pgf@process{\pgf@temp}%
  \TYPE{tate: (\the\pgf@x,\the\pgf@y)}%
  \pgf@process{\pgfpointanchor{current page}{north east}}%
  \pgf@xa=\pgf@x \pgf@ya=\pgf@y
  \pgf@process{\pgfpointanchor{current page}{south west}}%
  \advance\pgf@xa by-\pgf@x \advance\pgf@ya by-\pgf@y
  \TYPE{tate page: (\the\pgf@xa,\the\pgf@ya)}}}
\hbox{\yoko\tikz{%
  \pgfsys@getposition{pgfid@test}\pgf@temp
  \pgf@process{\pgf@temp}%
  \TYPE{yoko: (\the\pgf@x,\the\pgf@y)}}}
\hbox{\tate\tikz\node{\hbox{\yoko\tikz{%
  \pgf@process{\pgfpointanchor{current page}{north east}}%
  \pgf@xa=\pgf@x \pgf@ya=\pgf@y
  \pgf@process{\pgfpointanchor{current page}{south west}}%
  \advance\pgf@xa by-\pgf@x \advance\pgf@ya by-\pgf@y
  \TYPE{yoko in tate page: (\the\pgf@xa,\the\pgf@ya)}}}};}
\ENDTEST

\END
