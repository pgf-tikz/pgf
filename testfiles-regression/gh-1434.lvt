% -*- mode: latex -*-
% vim: ft=tex
\documentclass{minimal}
\input{pgf-regression-test}

\usepackage{pgfsys}

\START

\BEGINTEST{Scaling bp to pt across multiple orders of magnitude}
\catcode`\@=11

% Negative values

\pgf@x=-10000bp
\pgf@sys@bp@correct\pgf@x
\TYPE{\the\pgf@x=-10000.0pt}

\pgf@x=-1000bp
\pgf@sys@bp@correct\pgf@x
\TYPE{\the\pgf@x=-1000.0pt}

\pgf@x=-100bp
\pgf@sys@bp@correct\pgf@x
\TYPE{\the\pgf@x=-100.0pt}

\pgf@x=-10bp
\pgf@sys@bp@correct\pgf@x
\TYPE{\the\pgf@x=-10.0pt}

\pgf@x=-1bp
\pgf@sys@bp@correct\pgf@x
\TYPE{\the\pgf@x=-1.0pt}

\pgf@x=-0.1bp
\pgf@sys@bp@correct\pgf@x
\TYPE{\the\pgf@x=-0.1pt}

\pgf@x=-0.01bp
\pgf@sys@bp@correct\pgf@x
\TYPE{\the\pgf@x=-0.01pt}

\pgf@x=-0.001bp
\pgf@sys@bp@correct\pgf@x
\TYPE{\the\pgf@x=-0.001pt}

\pgf@x=-0.0001bp
\pgf@sys@bp@correct\pgf@x
\TYPE{\the\pgf@x=-0.0001pt}

% Positive values

\pgf@x=0.0001bp
\pgf@sys@bp@correct\pgf@x
\TYPE{\the\pgf@x=0.0001pt}

\pgf@x=0.001bp
\pgf@sys@bp@correct\pgf@x
\TYPE{\the\pgf@x=0.001pt}

\pgf@x=0.01bp
\pgf@sys@bp@correct\pgf@x
\TYPE{\the\pgf@x=0.01pt}

\pgf@x=0.1bp
\pgf@sys@bp@correct\pgf@x
\TYPE{\the\pgf@x=0.1pt}

\pgf@x=1bp
\pgf@sys@bp@correct\pgf@x
\TYPE{\the\pgf@x=1.0pt}

\pgf@x=10bp
\pgf@sys@bp@correct\pgf@x
\TYPE{\the\pgf@x=10.0pt}

\pgf@x=100bp
\pgf@sys@bp@correct\pgf@x
\TYPE{\the\pgf@x=100.0pt}

\pgf@x=1000bp
\pgf@sys@bp@correct\pgf@x
\TYPE{\the\pgf@x=1000.0pt}

\pgf@x=10000bp
\pgf@sys@bp@correct\pgf@x
\TYPE{\the\pgf@x=10000.0pt}

\catcode`\@=12
\ENDTEST

\BEGINTEST{Scaling bp to pt in corner cases}
\catcode`\@=11

% Scaling down 1sp will remain 1sp which TeX rounds to 0.00002pt
\pgf@x=1sp
\pgf@sys@bp@correct{\pgf@x}
\TYPE{\the\pgf@x=0.00002pt}
\pgf@x=-1sp
\pgf@sys@bp@correct{\pgf@x}
\TYPE{\the\pgf@x=-0.00002pt}

% Absence of intermediate overflow (also incorrectly rounded)
\pgf@x=\maxdimen
\pgf@sys@bp@correct{\pgf@x}
\TYPE{\the\pgf@x>16322.78952pt}

\pgf@x=-\maxdimen
\pgf@sys@bp@correct{\pgf@x}
\TYPE{\the\pgf@x<-16322.78952pt}

\catcode`\@=12
\ENDTEST

\END
