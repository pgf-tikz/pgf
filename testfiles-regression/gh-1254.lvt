% -*- mode: latex -*-
% vim: ft=tex
\documentclass{article}
\input{pgf-regression-test}

\usepackage{pgfkeys}

\begin{document}

$x$ % set up math fonts

\START

\BEGINTEST{Expansion}

\edef\x{\pgfkeysvalueof{/a}}
\TYPE{\meaning\x}
\edef\x{\pgfkeysunexpandedvalueof{/a}}
\TYPE{\meaning\x}
\edef\x{\pgfkeysdetokenizedvalueof{/a}}
\TYPE{\meaning\x}

\pgfkeys{/a/.initial = a}

\edef\x{\pgfkeysvalueof{/a}}
\TYPE{\meaning\x}
\edef\x{\pgfkeysunexpandedvalueof{/a}}
\TYPE{\meaning\x}
\edef\x{\pgfkeysdetokenizedvalueof{/a}}
\TYPE{\meaning\x}

\def\macro{a}
\pgfkeys{/a = \macro}

\edef\x{\pgfkeysvalueof{/a}}
\TYPE{\meaning\x}
\edef\x{\pgfkeysunexpandedvalueof{/a}}
\TYPE{\meaning\x}
\edef\x{\pgfkeysdetokenizedvalueof{/a}}
\TYPE{\meaning\x}

\ENDTEST

\BEGINTEST{Tokenization}

\pgfkeys{/b/.initial = {$}}
\edef\x{\pgfkeysvalueof{/b}}
\TYPE{\ifcat\x$math-shift\else letter\fi}
\edef\x{\pgfkeysunexpandedvalueof{/b}}
\TYPE{\ifcat\x$math-shift\else letter\fi}
\edef\x{\pgfkeysdetokenizedvalueof{/b}}
\TYPE{\ifcat\x$math-shift\else letter\fi}

\ENDTEST

\BEGINTEST{Emptyness}

\pgfkeysifempty{/c}{\TYPE{Is empty}}{\TYPE{Is not empty}}

\pgfkeys{/c/.initial = }
\pgfkeysifempty{/c}{\TYPE{Is empty}}{\TYPE{Is not empty}}

\pgfkeys{/c/.initial = has value}
\pgfkeysifempty{/c}{\TYPE{Is empty}}{\TYPE{Is not empty}}

\ENDTEST

\END
