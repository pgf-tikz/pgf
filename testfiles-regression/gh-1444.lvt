% -*- mode: latex -*-
% vim: ft=tex
\documentclass{minimal}
\input{pgf-regression-test}

\usepackage{pgfmath}

\begin{document}

\START

\BEGINTEST{pgfmathscientific for basic and extended range}

% representable small values are no longer flushed to zero (rounding errors remain)
\pgfmathscientific{5}{-4}\TYPE{\pgfmathresult=0.0005}
\pgfmathscientific{500}{-6}\TYPE{\pgfmathresult=0.0005}
\pgfmathscientific{5}{-5}\TYPE{\pgfmathresult=0.00005}
\pgfmathscientific{15}{-5}\TYPE{\pgfmathresult=0.00015}

% flush to zero for exponents < -9
\pgfmathscientific{1}{-5}\TYPE{\pgfmathresult=0.00001}
\pgfmathscientific{20000}{-9}\TYPE{\pgfmathresult=0.00002}
\pgfmathscientific{1}{-10}\TYPE{\pgfmathresult=0.0}
\pgfmathscientific{1}{-20}\TYPE{\pgfmathresult=0.0}

% boundary, unchanged from before the fix
\pgfmathscientific{1}{-4}\TYPE{\pgfmathresult=0.0001}

% the sign is preserved
\pgfmathscientific{-5}{-4}\TYPE{\pgfmathresult=-0.0005}
\pgfmathscientific{-2}{-1}\TYPE{\pgfmathresult=-0.2}
\pgfmathscientific{-+---+--1.5}{-3}\TYPE{\pgfmathresult=0.0015}
\pgfmathscientific{-0.5}{-3}\TYPE{\pgfmathresult=-0.0005}

% large integer-part mantissa no longer raises "Dimension too large"
\pgfmathscientific{20000}{-5}\TYPE{\pgfmathresult=0.2}

% positive exponents and ordinary values are unchanged
\pgfmathscientific{1}{4}\TYPE{\pgfmathresult=10000.0}
\pgfmathscientific{1.23456789123}{4}\TYPE{\pgfmathresult=12345.67891}

% via the parser
\pgfmathparse{9e-5}\TYPE{\pgfmathresult=0.00009}
\pgfmathparse{1.5e-4}\TYPE{\pgfmathresult=0.00015}
\pgfmathparse{5e-4}\TYPE{\pgfmathresult=0.0005}
\pgfmathparse{-3e-5}\TYPE{\pgfmathresult=-0.00003}

\ENDTEST

\END
