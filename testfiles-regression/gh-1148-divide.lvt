\documentclass{minimal}
\input{pgf-regression-test}

\usepackage{pgfmath}

\begin{document}

\START

\BEGINTEST{Division across multiple orders of magnitude}

% Positive results
\pgfmathparse{1/8}\TYPE{\pgfmathresult=0.125}
\pgfmathparse{10/4}\TYPE{\pgfmathresult=2.5}
\pgfmathparse{100/7}\TYPE{\pgfmathresult=14.28572}
\pgfmathparse{1000/3}\TYPE{\pgfmathresult=333.33333}
\pgfmathparse{16000/2}\TYPE{\pgfmathresult=8000.0}
\pgfmathparse{1/16000}\TYPE{\pgfmathresult=0.00006}
\pgfmathparse{0.001/7}\TYPE{\pgfmathresult=0.00014}
\pgfmathparse{12345.678/9.87654}\TYPE{\pgfmathresult=1250.0003}

% Small denominator: the result spans up towards the representable maximum
\pgfmathparse{1/0.001}\TYPE{\pgfmathresult=1000.0}
\pgfmathparse{2/0.001}\TYPE{\pgfmathresult=2000.0}

% Signs and zero numerator
\pgfmathparse{-7/3}\TYPE{\pgfmathresult=-2.33333}
\pgfmathparse{7/-3}\TYPE{\pgfmathresult=-2.33333}
\pgfmathparse{-7/-3}\TYPE{\pgfmathresult=2.33333}
\pgfmathparse{-1000/3}\TYPE{\pgfmathresult=-333.33333}
\pgfmathparse{0/5}\TYPE{\pgfmathresult=0.0}

\ENDTEST

\BEGINTEST{Division of previously incorrect results}

\pgfmathparse{38.89993/38.9}\TYPE{\pgfmathresult=1.0}%   was 1.2
\pgfmathparse{2.49998/2.5}\TYPE{\pgfmathresult=0.99998}% was 1.001
\pgfmathparse{1/6}\TYPE{\pgfmathresult=0.16667}%         was 0.16666

\ENDTEST

\END
