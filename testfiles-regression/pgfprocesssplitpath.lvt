% -*- mode: latex -*-
% vim: ft=tex
\documentclass{minimal}
\input{regression-test}

\usepackage{pgf}

\makeatletter
\newif\ifshowprefix
% #1 = path construction code, #2 = \pgfprocesssplitpath or
% \pgfprocesssplitsubpath. Checks that prefix and suffix together give
% back the original path, and shows the suffix (and short prefixes).
\def\checksplit#1#2{%
  \pgfsyssoftpath@setcurrentpath\pgfutil@empty
  #1%
  \pgfsyssoftpath@getcurrentpath\testpath
  \ifx#2\pgfprocesssplitpath
    \pgfprocesssplitpath\testpath
    \let\prefix\pgfprocessresultpathprefix
    \let\suffix\pgfprocessresultpathsuffix
  \else
    \pgfprocesssplitsubpath\testpath
    \let\prefix\pgfprocessresultsubpathprefix
    \let\suffix\pgfprocessresultsubpathsuffix
  \fi
  \edef\joined{\unexpanded\expandafter{\prefix}\unexpanded\expandafter{\suffix}}%
  \ifx\joined\testpath \TYPE{prefix+suffix: PASSED}\else \TYPE{prefix+suffix: FAILED}\fi
  \ifshowprefix \TYPE{prefix: \meaning\prefix}\fi
  \TYPE{suffix: \meaning\suffix}%
  \pgfsyssoftpath@setcurrentpath\pgfutil@empty
}
\def\m#1{\pgfsyssoftpath@moveto{#1pt}{0pt}}
\def\l#1{\pgfsyssoftpath@lineto{#1pt}{1pt}}
\def\c#1{\pgfsyssoftpath@curveto{#1pt}{2pt}{#1pt}{3pt}{#1pt}{4pt}}
\def\z{\pgfsyssoftpath@closepath}
\def\r{\pgfsyssoftpath@rect{1pt}{2pt}{3pt}{4pt}}
% #1 subpaths of moveto + lineto
\def\manysubpaths#1{%
  \pgfmathloop\ifnum\pgfmathcounter>#1 \else
    \m{\pgfmathcounter}\l{\pgfmathcounter}%
  \repeatpgfmathloop}
% a moveto followed by #1 linetos
\def\manylines#1{%
  \m{0}%
  \pgfmathloop\ifnum\pgfmathcounter>#1 \else
    \l{\pgfmathcounter}%
  \repeatpgfmathloop}
\makeatother

\begin{document}

\START

\BEGINTEST{\pgfprocesssplitpath, short paths}
\showprefixtrue
\checksplit{}\pgfprocesssplitpath
\checksplit{\m1}\pgfprocesssplitpath
\checksplit{\l1\l2}\pgfprocesssplitpath
\checksplit{\m1\l2\m3\l4}\pgfprocesssplitpath
\checksplit{\m1\l2\m3}\pgfprocesssplitpath
\checksplit{\m1\c2\z\m3\c4}\pgfprocesssplitpath
\checksplit{\r\m5\l6}\pgfprocesssplitpath
\ENDTEST

\BEGINTEST{\pgfprocesssplitpath, many subpaths}
\showprefixfalse
\checksplit{\manysubpaths{63}}\pgfprocesssplitpath
\checksplit{\manysubpaths{64}}\pgfprocesssplitpath
\checksplit{\manysubpaths{65}}\pgfprocesssplitpath
\checksplit{\manysubpaths{200}}\pgfprocesssplitpath
\ENDTEST

\BEGINTEST{\pgfprocesssplitsubpath, short subpaths}
\showprefixtrue
\checksplit{\m1\l2}\pgfprocesssplitsubpath
\checksplit{\m1\c2}\pgfprocesssplitsubpath
\checksplit{\m1\l2\l3}\pgfprocesssplitsubpath
\checksplit{\m1\l2\c3}\pgfprocesssplitsubpath
\checksplit{\m1\c2\c3}\pgfprocesssplitsubpath
\checksplit{\m1\l2\l3\z}\pgfprocesssplitsubpath
\ENDTEST

\BEGINTEST{\pgfprocesssplitsubpath, long subpaths}
\showprefixfalse
\checksplit{\manylines{63}}\pgfprocesssplitsubpath
\checksplit{\manylines{64}}\pgfprocesssplitsubpath
\checksplit{\manylines{65}\c{66}}\pgfprocesssplitsubpath
\checksplit{\manylines{200}}\pgfprocesssplitsubpath
\ENDTEST

\END
