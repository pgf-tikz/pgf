\documentclass{minimal}
\input{pgf-regression-test}

\usepackage{pgfmath}

\begin{document}

\START

\BEGINTEST{Reciprocal across multiple orders of magnitude}

% Positive values
\pgfmathparse{reciprocal(0.0001)}\TYPE{\pgfmathresult=10000.0}
\pgfmathparse{reciprocal(0.001)}\TYPE{\pgfmathresult=1000.0}
\pgfmathparse{reciprocal(0.01)}\TYPE{\pgfmathresult=100.0}
\pgfmathparse{reciprocal(0.1)}\TYPE{\pgfmathresult=10.0}
\pgfmathparse{reciprocal(1)}\TYPE{\pgfmathresult=1.0}
\pgfmathparse{reciprocal(10)}\TYPE{\pgfmathresult=0.1}
\pgfmathparse{reciprocal(100)}\TYPE{\pgfmathresult=0.01}
\pgfmathparse{reciprocal(1000)}\TYPE{\pgfmathresult=0.001}
\pgfmathparse{reciprocal(10000)}\TYPE{\pgfmathresult=0.0001}

% Negative values
\pgfmathparse{reciprocal(-0.0001)}\TYPE{\pgfmathresult=-10000.0}
\pgfmathparse{reciprocal(-0.001)}\TYPE{\pgfmathresult=-1000.0}
\pgfmathparse{reciprocal(-0.01)}\TYPE{\pgfmathresult=-100.0}
\pgfmathparse{reciprocal(-0.1)}\TYPE{\pgfmathresult=-10.0}
\pgfmathparse{reciprocal(-1)}\TYPE{\pgfmathresult=-1.0}
\pgfmathparse{reciprocal(-10)}\TYPE{\pgfmathresult=-0.1}
\pgfmathparse{reciprocal(-100)}\TYPE{\pgfmathresult=-0.01}
\pgfmathparse{reciprocal(-1000)}\TYPE{\pgfmathresult=-0.001}
\pgfmathparse{reciprocal(-10000)}\TYPE{\pgfmathresult=-0.0001}

\ENDTEST

\BEGINTEST{Reciprocal of previously incorrect results}

\pgfmathparse{reciprocal(1.25)}\TYPE{\pgfmathresult=0.8}%    was 0.80019
\pgfmathparse{reciprocal(1.6)}\TYPE{\pgfmathresult=0.625}%   was 0.62515
\pgfmathparse{reciprocal(6.25)}\TYPE{\pgfmathresult=0.16}%   was 0.16003
\pgfmathparse{reciprocal(12.5)}\TYPE{\pgfmathresult=0.08}%   was 0.08002
\pgfmathparse{reciprocal(50)}\TYPE{\pgfmathresult=0.02}%     was 0.01999
\pgfmathparse{reciprocal(-1.25)}\TYPE{\pgfmathresult=-0.8}%  was -0.80019
\pgfmathparse{reciprocal(-6.25)}\TYPE{\pgfmathresult=-0.16}% was -0.16003
\pgfmathparse{reciprocal(-50)}\TYPE{\pgfmathresult=-0.02}%   was -0.01999

\ENDTEST

\BEGINTEST{Reciprocal of previously correct results}

\pgfmathparse{reciprocal(2)}\TYPE{\pgfmathresult=0.5}
\pgfmathparse{reciprocal(3)}\TYPE{\pgfmathresult=0.33333}
\pgfmathparse{reciprocal(4)}\TYPE{\pgfmathresult=0.25}
\pgfmathparse{reciprocal(8)}\TYPE{\pgfmathresult=0.125}
\pgfmathparse{reciprocal(0.5)}\TYPE{\pgfmathresult=2.0}
\pgfmathparse{reciprocal(0.25)}\TYPE{\pgfmathresult=4.0}
\pgfmathparse{reciprocal(0.125)}\TYPE{\pgfmathresult=8.0}
\pgfmathparse{reciprocal(-2)}\TYPE{\pgfmathresult=-0.5}
\pgfmathparse{reciprocal(-0.25)}\TYPE{\pgfmathresult=-4.0}

\ENDTEST

\END
