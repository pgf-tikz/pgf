% -*- mode: latex -*-
% vim: ft=tex
\documentclass{minimal}
\input{regression-test}

\usepackage{tikz}
\usetikzlibrary{intersections}

\makeatletter
% Typeset the number of solutions and, for each solution, its coordinates
% and segment indices.
\def\showintersections#1#2{%
  \pgfintersectionofpaths{#1}{#2}%
  \TYPE{solutions: \pgfintersectionsolutions}%
  \pgfmathloop
    \ifnum\pgfmathcounter>\pgfintersectionsolutions\relax
    \else
      \pgf@process{\pgfpointintersectionsolution{\pgfmathcounter}}%
      \pgfintersectiongetsolutionsegmentindices{\pgfmathcounter}{\first}{\second}%
      \TYPE{(\the\pgf@x, \the\pgf@y) segments \first, \second}%
  \repeatpgfmathloop
}
\makeatother

\begin{document}

\START

\BEGINTEST{Intersections of circles (zero-length closepath)}
\showintersections
  {\pgfpathcircle{\pgfpointorigin}{1cm}}
  {\pgfpathcircle{\pgfpointpolar{0}{1cm}}{1cm}}
\showintersections
  {\pgfpathcircle{\pgfpointorigin}{1cm}}
  {\pgfpathcircle{\pgfpointpolar{60}{1cm}}{1cm}}
\showintersections
  {\pgfpathcircle{\pgfpointorigin}{1cm}}
  {\pgfpathcircle{\pgfpointpolar{120}{1cm}}{1cm}}
\ENDTEST

\BEGINTEST{Segment indices after a circle are unchanged}
\showintersections
  {%
    \pgfpathcircle{\pgfpointorigin}{1cm}%
    \pgfpathmoveto{\pgfpoint{2cm}{-1cm}}%
    \pgfpathlineto{\pgfpoint{2cm}{1cm}}%
  }
  {%
    \pgfpathmoveto{\pgfpoint{-2cm}{0.5cm}}%
    \pgfpathlineto{\pgfpoint{3cm}{0.5cm}}%
  }
\ENDTEST

\BEGINTEST{Non-degenerate closepath still intersects}
\showintersections
  {%
    \pgfpathmoveto{\pgfpointorigin}%
    \pgfpathlineto{\pgfpoint{2cm}{0cm}}%
    \pgfpathlineto{\pgfpoint{2cm}{2cm}}%
    \pgfpathclose
  }
  {%
    \pgfpathmoveto{\pgfpoint{0cm}{1cm}}%
    \pgfpathlineto{\pgfpoint{2cm}{0cm}}%
  }
\ENDTEST

\END
