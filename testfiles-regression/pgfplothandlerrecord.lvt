% -*- mode: latex -*-
% vim: ft=tex
\documentclass{minimal}
\input{regression-test}

\usepackage{pgf}

\makeatletter
% Record n points (and a jump and a special after the first point) and
% check that the recording has the same commands as the stream.
\def\checkrecord#1{%
  \pgfplothandlerrecord\recorded
  \def\expected{\pgfplotstreamstart}%
  \pgfplotstreamstart
  \count@=0
  \loop\ifnum\count@<#1
    \advance\count@ by 1
    \edef\point{\noexpand\pgfqpoint{\the\count@ pt}{0pt}}%
    \expandafter\pgfplotstreampoint\expandafter{\point}%
    \edef\expected{\unexpanded\expandafter{\expected}%
      \noexpand\pgfplotstreampoint{\unexpanded\expandafter{\point}}}%
    \ifnum\count@=1
      \pgf@plotstreamjump\pgfplotstreamspecial{x}%
      \def\next{\pgf@plotstreamjump\pgfplotstreamspecial{x}}%
      \edef\expected{\unexpanded\expandafter{\expected}\unexpanded\expandafter{\next}}%
    \fi
  \repeat
  \pgfplotstreamend
  \edef\expected{\unexpanded\expandafter{\expected}\noexpand\pgfplotstreamend}%
  \ifx\recorded\expected
    \TYPE{#1 points: PASSED}%
  \else
    \TYPE{#1 points: FAILED}%
  \fi
}
\makeatother

\begin{document}

\START

\BEGINTEST{\pgfplothandlerrecord}
% Commands are buffered and flushed every 64 commands (and at the end).
% With the jump, the special and the end, n points are n+3 commands.
\checkrecord{0}
\checkrecord{1}
\checkrecord{60}
\checkrecord{61}
\checkrecord{62}
\checkrecord{124}
\checkrecord{125}
\checkrecord{126}
\checkrecord{300}
\ENDTEST

\END
