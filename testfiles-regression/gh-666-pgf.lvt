\documentclass{minimal}
\input{pgf-regression-test}

\RequirePackage{pgf}

\begin{document}

\START

\BEGINBOXTEST{pgf: \pgfpathmoveto}
\pgfpicture
  \pgfpathmoveto{\pgfpoint{1cm}{1cm}}
  \pgfusepathqstroke
\endpgfpicture
\ENDBOXTEST

\BEGINBOXTEST{pgf: \pgfpathlineto}
\pgfpicture
  \pgfpathlineto{\pgfpoint{1cm}{1cm}}
  \pgfusepathqstroke
\endpgfpicture
\ENDBOXTEST

\END
